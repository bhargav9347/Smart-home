<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Travel_Dates</fullName>
    <active>true</active>
    <description>Travel end date must be on or after the start date.</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Travel_Start_Date__c)),
  NOT(ISBLANK(Travel_End_Date__c)),
  Travel_End_Date__c &lt; Travel_Start_Date__c
)</errorConditionFormula>
    <errorDisplayField>Travel_End_Date__c</errorDisplayField>
    <errorMessage>Travel End Date cannot be earlier than Travel Start Date.</errorMessage>
</ValidationRule>
